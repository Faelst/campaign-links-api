meta {
  name: Create Parameter
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/parameters
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "key": "utm_source",
    "value": "facebook"
  }
}

script:post-response {
  const data = res.getBody();

  if (data.id) {
    bru.setEnvVar("parameterId", data.id);
  }
}
