meta {
  name: Create Project
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/projects
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Campanha Black Friday"
  }
}

script:post-response {
  const data = res.getBody();

  if (data.id) {
    bru.setEnvVar("projectId", data.id);
  }
}
