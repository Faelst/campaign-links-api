meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Rafael Silverio",
    "email": "fael_st_2@example.com",
    "password": "123456"
  }
}

script:post-response {
  const data = res.getBody();
  
  if (data.accessToken) {
    bru.setEnvVar("accessToken", data.accessToken);
  }
  
  if (data.user?.id) {
    bru.setEnvVar("userId", data.user.id);
  }
}
