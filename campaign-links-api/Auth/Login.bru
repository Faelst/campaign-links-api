meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "jose@example.com",
    "password": "123456"
  }
}

script:post-response {
  const data = res.getBody();

  if (data.accessToken) {
    bru.setEnvVar("accessToken", data.accessToken);
  }

  if (data.user?.id) {
    bru.setEnvVar("userId", data.user.id);
  }
}
