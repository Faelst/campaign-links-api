meta {
  name: Create User
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/users
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "David",
    "email": "david@example.com",
    "password": "123456"
  }
}

script:post-response {
  const data = res.getBody();

  if (data.id) {
    bru.setEnvVar("userId", data.id);
  }
}
