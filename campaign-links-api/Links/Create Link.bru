meta {
  name: Create Link
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/projects/{{projectId}}/links
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Link principal da campanha",
    "baseUrl": "https://example.com",
    "parameterIds": [
      "{{parameterId}}"
    ],
    "parameters": [
      {
        "key": "utm_campaign",
        "value": "black_friday"
      }
    ],
    "redirect": {
      "targetUrl": "https://landing.example.com",
      "paramKey": "redirect",
      "statusCode": 302
    }
  }
}

script:post-response {
  const data = res.getBody();

  if (data.id) {
    bru.setEnvVar("linkId", data.id);
  }
}
