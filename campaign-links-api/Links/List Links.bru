meta {
  name: List Links
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/links?page=1&limit=10&projectId={{projectId}}&search=campanha
  body: none
  auth: bearer
}

params:query {
  page: 1
  limit: 10
  projectId: {{projectId}}
  search: campanha
  ~hasRedirect: true
}

auth:bearer {
  token: {{accessToken}}
}
